# Upstash Redis (Vercel Marketplace → Upstash, or https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Market data — set Finnhub (preferred) and/or Alpaca
FINNHUB_API_KEY=
# Optional: free-tier Finnhub calls/minute budget (default 55)
FINNHUB_RPM=55
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Nigerian Exchange (NGX) via NGN Market — https://ngnmarket.com/developer
# Free plan: live quotes + blog headlines (desk works).
# Hobby+: full OHLC charts. Starter+: dedicated company news.
NGNMARKET_API_KEY=

# Protects /api/cron/scan (Vercel sets Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Clerk auth (https://dashboard.clerk.com)
# Preferred local URL on this machine: http://127.0.0.1:3000
# Also add http://localhost:3000 and http://signaldesk.local:3000 in Clerk allowed origins.
# Run once: npm run dev:fix-hosts   (fixes /etc/hosts; needs sudo password)
# If Chrome still breaks "localhost": chrome://settings/security → Secure DNS → Off
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini (AI Studio / Google AI)
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend — Attention mail to users + capability-gap emails to the product owner
# https://resend.com → API Keys; verify kiloapp.org and allow sidechick-invest@kiloapp.org
RESEND_API_KEY=
RESEND_FROM_EMAIL=Signal Desk <sidechick-invest@kiloapp.org>
CAPABILITY_GAP_EMAIL=yembot31013@gmail.com
